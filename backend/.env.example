# Server
PORT=5000
NODE_ENV=development

# Origins allowed to call this API. Comma-separated; no wildcard.
# Production: add the deployed frontend origin.
CLIENT_URLS=http://localhost:3000

# Database — Supabase PostgreSQL.
#
# Use the SESSION POOLER, not the direct connection: the direct endpoint
# (db.<ref>.supabase.co) is IPv6-only and unreachable from an IPv4-only network.
#
#   - the pooler username is postgres.<project-ref>, not postgres
#   - percent-encode the password: # -> %23, @ -> %40
#     (an unencoded # silently truncates the password to empty)
DATABASE_URL=

# Supabase Auth.
# SUPABASE_URL is https://<project-ref>.supabase.co
SUPABASE_URL=
SUPABASE_PUBLISHABLE_KEY=

# Elevated. Bypasses RLS and can create users. Required only for administrator
# invitations. Never prefix with NEXT_PUBLIC_ and never send to a client.
SUPABASE_SECRET_KEY=

# ---------------------------------------------------------------------------
# Ollama
# ---------------------------------------------------------------------------
# Two modes. Local needs no key; cloud does.
#
#   LOCAL   OLLAMA_BASE_URL=http://localhost:11434   OLLAMA_API_KEY=  (empty)
#   CLOUD   OLLAMA_BASE_URL=https://ollama.com       OLLAMA_API_KEY=  (required)
#
# The deployed backend cannot reach a laptop-local Ollama, so production uses
# cloud. Never prefix any of these NEXT_PUBLIC_ and never put them in the
# frontend: the browser calls this API, and this API calls Ollama.
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=
# Must match the vector(768) column. Changing it means re-embedding the corpus.
OLLAMA_EMBED_MODEL=nomic-embed-text
OLLAMA_API_KEY=

# 32-byte base64 key for AES-256-GCM encryption of per-user AI credentials.
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
AI_CREDENTIAL_ENCRYPTION_KEY=
