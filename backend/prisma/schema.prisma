// Sarthi — canonical persistence model.
//
// SIH Problem Statement 26136: a startup-friendly public procurement mechanism
// letting government departments identify, pilot, procure and scale innovative
// solutions from eligible startups.
//
// The schema follows the lifecycle end to end:
//
//   Challenge → StartupMatch → Evaluation → Pilot → Milestones/Metrics/Evidence
//             → ScaleDecision
//
// Three rules govern every model here.
//
//   1. Supabase Auth owns credentials. There is no password column anywhere in
//      this file, and there is no second authentication system.
//
//   2. Every record declares where it came from. `DataOrigin` separates an
//      externally sourced fact from a labelled demo scenario from a record a
//      signed-in user created. A VERIFIED row without an `EvidenceSource` is
//      refused by a CHECK constraint, so "verified" is a guarantee rather than
//      a string any bug can write.
//
//   3. AI is advisory. `StartupMatch` holds a recommendation, `Evaluation`
//      holds the human review of it, and `ScaleDecision` holds the government
//      decision. No model lets a score stand in for a decision.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ------------------------------------------------------------------
// Provenance
// ------------------------------------------------------------------

/// Where a record came from. Mirrors `frontend/src/lib/provenance.ts`, with one
/// addition the database needs and the frontend does not.
///
///   VERIFIED     an externally sourced fact, which MUST cite an EvidenceSource.
///   DEMO         a deliberately constructed scenario, labelled as one.
///   USER_ENTERED a first-party record created by an authenticated user.
///
/// USER_ENTERED exists so a department's own challenge is not forced to pretend
/// it was sourced from somewhere external. The frontend's `pending` state has no
/// counterpart here on purpose: an absent fact is a NULL column or a missing
/// row, which is exactly what `pending` means — a value that cannot be printed
/// because it does not exist.
enum DataOrigin {
  VERIFIED
  DEMO
  USER_ENTERED
}

/// What kind of thing a source is. Kept coarse: this records what a reader is
/// looking at, not a claim about how much it should be trusted.
enum EvidenceSourceKind {
  OFFICIAL_GOVERNMENT
  PROGRAM_PAGE
  POLICY
  REPORT
  DATABASE
  NEWS
  OTHER
}

/// A citable source, with the date it was read.
///
/// The retrieval date is required rather than optional because a government
/// figure without one is unfalsifiable — a reader cannot tell whether it is
/// current, and re-checking it later has nothing to compare against.
model EvidenceSource {
  id          String             @id @default(uuid())
  publisher   String
  title       String
  url         String?
  retrievedAt DateTime           @db.Date
  kind        EvidenceSourceKind
  notes       String?

  createdAt DateTime @default(now())

  startups       Startup[]
  fundingRounds  FundingRound[]
  programs       GovernmentProgram[]
  participations StartupProgramParticipation[]
  documents      Document[]

  @@index([kind])
  @@map("evidence_sources")
}

// ------------------------------------------------------------------
// Authentication and user settings
// ------------------------------------------------------------------

enum UserRole {
  GOVERNMENT_OFFICER
  STARTUP
  EVALUATOR
  ADMIN
}

/// The application's view of a person. Supabase Auth owns the account.
///
/// `id` holds the `auth.users` UUID verbatim. There is deliberately no foreign
/// key to it: `auth` is outside the Prisma schema, and a cross-schema FK here
/// would tie migrations to a schema Supabase manages. The row is created by a
/// trigger on `auth.users` (or by controlled backend synchronisation), which is
/// the standard Supabase pattern.
///
/// ADMIN must never be reachable through public signup. That is a backend
/// authorisation rule; the database cannot tell a self-serve signup from an
/// administrative grant.
model UserProfile {
  id             String   @id
  email          String   @unique
  displayName    String
  role           UserRole
  /// Set for government and evaluator users. A department is not a Startup, so
  /// this is a plain label rather than a relation.
  departmentName String?
  designation    String?

  /// Set only for startup users. Government and evaluator users have no
  /// Startup, which is why this is nullable rather than a required relation.
  startup   Startup? @relation(fields: [startupId], references: [id], onDelete: SetNull)
  startupId String?  @unique

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  aiConnections      AIProviderConnection[]
  ownedChallenges    Challenge[]
  evaluations        Evaluation[]
  submittedEvidence  PilotEvidence[]        @relation("EvidenceSubmitter")
  reviewedEvidence   PilotEvidence[]        @relation("EvidenceReviewer")
  challengeResponses ChallengeResponse[]
  scaleDecisions     ScaleDecision[]
  createdScenarios   SimulationScenario[]
  simulationRuns     PilotSimulationRun[]

  @@index([role])
  @@index([startupId])
  @@map("user_profiles")
}

enum AIProvider {
  OLLAMA
  ANTHROPIC
}

/// A user's own AI provider configuration.
///
/// Credentials are stored only as AES-256-GCM ciphertext, with the encryption
/// key held in a backend environment secret and never in this database. The
/// decrypted value is never returned by the API, never logged, and never
/// reaches the browser.
///
/// The shape differs by provider and a CHECK constraint enforces it, because a
/// half-populated credential is worse than none: OLLAMA is local and must carry
/// no credential at all, while ANTHROPIC must carry a complete one. A
/// permissive "ciphertext may be null" rule would let a hosted connection be
/// saved with a nonce but no ciphertext and fail only at call time.
model AIProviderConnection {
  id     String      @id @default(uuid())
  user   UserProfile @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId String

  provider AIProvider
  /// Ollama's host, e.g. `http://localhost:11434`. Null for hosted providers
  /// using their default endpoint.
  baseUrl  String?
  model    String

  /// AES-256-GCM ciphertext, nonce and authentication tag. All three NULL for
  /// OLLAMA; all three required for ANTHROPIC.
  keyCipher Bytes?
  keyNonce  Bytes?
  keyTag    Bytes?

  isDefault Boolean  @default(false)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  generatedMatches StartupMatch[]

  @@unique([userId, provider, model])
  @@index([userId])
  @@map("ai_provider_connections")
}

// ------------------------------------------------------------------
// Startup intelligence
// ------------------------------------------------------------------

/// How far a claim has been stood up.
///
/// `NOT_PROVIDED` is the default on every field that uses this, and it is the
/// important value: a company that has told us nothing about its security
/// posture must read as *silent*, never as compliant. The interface says
/// "cybersecurity evidence not provided", which is a fact, rather than leaving
/// a blank a reader fills in optimistically.
///
/// `VERIFIED` is reserved for a claim backed by an `EvidenceSource`. Nothing in
/// the onboarding form can set it — a company cannot verify itself.
enum AssuranceStatus {
  NOT_PROVIDED
  SELF_DECLARED
  PARTIALLY_VERIFIED
  VERIFIED
}

/// A graded reading, used where the honest answer is a band rather than a
/// boolean. `NOT_ASSESSED` is again the default and again the point.
enum ReadinessLevel {
  NOT_ASSESSED
  LOW
  MODERATE
  HIGH
}

/// A company. Facts about the company only.
///
/// There is deliberately no score on this model. Suitability is a property of a
/// (challenge, startup) pair, not of a startup — a company that is an excellent
/// answer to a water-distribution challenge is irrelevant to a transit one, and
/// a stored "startup quality" score would be read as the former while meaning
/// neither. Scores live on `StartupMatch`.
model Startup {
  id          String  @id @default(uuid())
  legalName   String
  displayName String?
  description String?
  sector      String
  industry    String?
  stage       String?
  state       String?
  city        String?
  website     String?
  /// DPIIT recognition status as published, verbatim. Not an inference.
  dpiitStatus String?

  // --- identity ---
  /// One sentence, used wherever the company is listed rather than opened.
  oneLineDescription String?
  foundedYear        Int?
  teamSize           Int?
  /// Who the founders are and what they have done, in prose. Deliberately not
  /// a structured people table: named individuals with roles and experience are
  /// personal data, and the government side needs the capability signal, not a
  /// staff directory.
  founderSummary     String?
  /// Roles and their relevant experience, without contact details. Json because
  /// the shape varies by company and nothing here is queried or scored.
  keyTeamMembers     Json?

  // --- what they build ---
  /// The problem the company exists to solve, in its own words.
  problemSolved      String?
  solutionSummary    String?
  productSummary     String?
  /// Who uses it. Feeds nothing automatically; a reader needs it to judge fit.
  targetUsers        String?
  deploymentModel    String?
  geographicCoverage String?

  // --- traction ---
  //
  // All optional. A company must not have to disclose commercial figures
  // simply to hold an account, and none of these is weighted as quality:
  // capital raised measures investor conviction about a company's future, not
  // whether its solution works in a specific ward.
  revenueBand            String?
  customerCount          Int?
  deploymentCount        Int?
  commercializationStage String?

  // --- government exposure ---
  /// Prose only. The *countable* signal is `participations`, which cites a
  /// programme and a source; this field cannot manufacture one.
  governmentExperienceSummary String?

  // --- assurance ---
  //
  // Every one of these defaults to the absent state. A profile that has said
  // nothing reads as silent rather than as satisfied.
  complianceStatus       AssuranceStatus @default(NOT_PROVIDED)
  cybersecurityStatus    AssuranceStatus @default(NOT_PROVIDED)
  dataPrivacyStatus      AssuranceStatus @default(NOT_PROVIDED)
  procurementReadiness   ReadinessLevel  @default(NOT_ASSESSED)
  requiredCertifications String[]

  // --- pilot readiness ---
  //
  // What the company says it *can* do. Actual pilot values live on `Pilot`,
  // and a pilot that departs from these numbers must never edit them back.
  pilotDurationDays          Int?
  pilotTeamSummary           String?
  infrastructureRequirements String?
  implementationDependencies String?
  deploymentRequirements     String?
  estimatedPilotBudget       Decimal? @db.Decimal(14, 2)
  scalingRequirements        String?

  /// What the company can actually do, and with what. These are the axes the
  /// matching engine scores against a challenge — without them `problemFit`
  /// and `technicalFit` would have nothing to compare and the scores would be
  /// decoration. Free-form tags rather than an enum: the vocabulary of a
  /// municipal problem domain is not knowable in advance.
  technologies String[]
  capabilities String[]

  origin   DataOrigin
  source   EvidenceSource? @relation(fields: [sourceId], references: [id], onDelete: Restrict)
  sourceId String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  /// Set when this company exists only inside a demonstration workspace.
  scenario   SimulationScenario? @relation(fields: [scenarioId], references: [id], onDelete: Cascade)
  scenarioId String?

  fundingRounds  FundingRound[]
  participations StartupProgramParticipation[]
  matches        StartupMatch[]
  responses      ChallengeResponse[]
  pilots         Pilot[]
  documents      StartupDocument[]
  simulationResults PilotSimulationResult[]
  /// The one startup user who has claimed this company. Enforced 1:1 by a
  /// unique constraint on `UserProfile.startupId`, so two people cannot claim
  /// the same demonstration slot.
  owner          UserProfile?

  @@index([scenarioId])
  @@index([sector])
  @@index([origin])
  @@index([state])
  @@map("startups")
}

/// One disclosed funding event.
///
/// Funding is one evidence signal among several and the schema does not weight
/// it. Capital raised measures investor conviction about a company's future,
/// not whether its solution works in a specific ward — conflating the two is
/// the error the product brief calls out as the central conceptual flaw to
/// avoid.
model FundingRound {
  id        String  @id @default(uuid())
  startup   Startup @relation(fields: [startupId], references: [id], onDelete: Cascade)
  startupId String

  roundType   String
  amount      Decimal?  @db.Decimal(14, 2)
  announcedOn DateTime? @db.Date
  investors   String[]

  origin   DataOrigin
  source   EvidenceSource? @relation(fields: [sourceId], references: [id], onDelete: Restrict)
  sourceId String?

  createdAt DateTime @default(now())

  @@index([startupId])
  @@index([origin])
  @@map("funding_rounds")
}

/// A government startup programme, as its operator publishes it.
///
/// Two matter for this problem statement: Maharashtra Startup Week (MSW), which
/// issues government work orders, and the Startup India Seed Fund Scheme
/// (SISFS).
model GovernmentProgram {
  id       String @id @default(uuid())
  /// Short stable handle, e.g. `MSW`, `SISFS`.
  code     String @unique
  name     String
  operator String
  purpose  String

  origin   DataOrigin
  source   EvidenceSource? @relation(fields: [sourceId], references: [id], onDelete: Restrict)
  sourceId String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  participations StartupProgramParticipation[]

  @@map("government_programs")
}

/// A startup's participation in a programme edition.
///
/// This is the highest-value evidence the platform holds for the problem
/// statement. A Maharashtra Startup Week winner has already delivered against a
/// government work order, which is the one thing the prior-experience
/// requirement asks for and the one thing most startups cannot show.
model StartupProgramParticipation {
  id        String            @id @default(uuid())
  startup   Startup           @relation(fields: [startupId], references: [id], onDelete: Cascade)
  startupId String
  program   GovernmentProgram @relation(fields: [programId], references: [id], onDelete: Cascade)
  programId String

  /// Programme edition, e.g. `2023`. Null where the source does not state one.
  edition              String?
  outcome              String?
  workOrderValue       Decimal? @db.Decimal(14, 2)
  sponsoringDepartment String?

  origin   DataOrigin
  source   EvidenceSource? @relation(fields: [sourceId], references: [id], onDelete: Restrict)
  sourceId String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  /// Scoped to the edition, because a startup may legitimately participate in
  /// more than one. NULL editions do not collide under Postgres NULL semantics,
  /// which is the wanted behaviour while a source does not state an edition.
  @@unique([startupId, programId, edition])
  @@index([programId])
  @@index([origin])
  @@map("startup_program_participations")
}

// ------------------------------------------------------------------
// Demonstration workspace
// ------------------------------------------------------------------

enum SimulationStatus {
  DRAFT
  ACTIVE
  CLOSED
}

/// A bounded workspace whose records are simulated.
///
/// This exists so demonstration data is separated *structurally* rather than by
/// a string convention scattered through the codebase. Everything created
/// inside a scenario hangs off this row, which makes two things true that a
/// `demo` flag alone could not guarantee: a query can exclude an entire
/// simulation with one join, and deleting the scenario removes every record it
/// produced rather than leaving orphans behind.
///
/// The users, their authentication, and every write are real. The *business
/// scenario* is simulated — a department problem nobody actually issued, and
/// companies that do not exist. That distinction is what the interface must
/// communicate, and why `disclaimer` is a required column rather than a string
/// in a React component: the label travels with the data.
model SimulationScenario {
  id          String           @id @default(uuid())
  name        String
  description String
  status      SimulationStatus @default(DRAFT)

  /// Shown wherever records from this scenario appear.
  disclaimer String @default("Simulated for demonstration. Not a government decision, procurement notice, contract, payment or departmental record.")

  createdBy       UserProfile @relation(fields: [createdByUserId], references: [id], onDelete: Restrict)
  createdByUserId String

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  challenges Challenge[]
  startups   Startup[]
  pilots     Pilot[]

  @@index([status])
  @@map("simulation_scenarios")
}

enum ResponseStatus {
  DRAFT
  SUBMITTED
  WITHDRAWN
}

/// A startup's answer to a challenge.
///
/// Distinct from `StartupMatch` on purpose, and the distinction is the product:
/// a response is what the *company says about itself*, a match is what the
/// *system computed*. Storing a score without the claim it was derived from
/// would leave a government officer unable to check the reasoning, which is
/// exactly the review this platform exists to support.
///
/// Everything here is the startup's own assertion. Nothing in this model is
/// verified, and none of it may be rendered as fact.
model ChallengeResponse {
  id          String    @id @default(uuid())
  challenge   Challenge @relation(fields: [challengeId], references: [id], onDelete: Cascade)
  challengeId String
  startup     Startup   @relation(fields: [startupId], references: [id], onDelete: Cascade)
  startupId   String

  solutionSummary    String
  capabilities       String[]
  technologies       String[]
  deploymentApproach String
  expectedResult     String
  pilotApproach      String
  constraints        String?
  /// Free-text pointers to supporting material the startup can produce.
  evidenceReferences String[]

  status ResponseStatus @default(DRAFT)

  /// Who filed it, from the verified token — never from the request body.
  submittedBy       UserProfile @relation(fields: [submittedByUserId], references: [id], onDelete: Restrict)
  submittedByUserId String
  submittedAt       DateTime?

  origin DataOrigin

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  /// One response per startup per challenge; editing replaces, never appends.
  @@unique([challengeId, startupId])
  @@index([challengeId])
  @@index([startupId])
  @@index([status])
  @@map("challenge_responses")
}

// ------------------------------------------------------------------
// Procurement pathway
// ------------------------------------------------------------------

enum ChallengeStatus {
  DRAFT
  PUBLISHED
  MATCHING
  UNDER_EVALUATION
  PILOT_READY
  CLOSED
}

/// A department's problem, stated as an outcome.
///
/// `targetMetric` and `targetValue` are separate columns rather than prose
/// because the whole pathway downstream depends on the target being machine
/// readable: the pilot measures against it, and the scale decision is defended
/// by reference to it. A challenge phrased as a product ("buy an AI water
/// platform") has nothing to measure; one phrased as an outcome ("reduce
/// non-revenue water by 20% over a 90-day pilot") does.
model Challenge {
  id          String      @id @default(uuid())
  owner       UserProfile @relation(fields: [ownerUserId], references: [id], onDelete: Restrict)
  ownerUserId String

  department       String
  title            String
  problemStatement String
  /// Primary similarity axis for discovery, e.g. `water-distribution`.
  domain           String
  technologies     String[]

  targetMetric      String
  targetValue       Float?
  budgetEnvelope    Decimal? @db.Decimal(14, 2)
  pilotDurationDays Int?

  status ChallengeStatus @default(DRAFT)

  origin       DataOrigin
  /// One line naming the scenario, set only on DEMO rows so the interface can
  /// label it rather than the reader having to infer it.
  demoScenario String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  /// Set when the challenge belongs to a demonstration workspace.
  scenario   SimulationScenario? @relation(fields: [scenarioId], references: [id], onDelete: Cascade)
  scenarioId String?

  matches   StartupMatch[]
  responses ChallengeResponse[]
  pilots    Pilot[]
  simulationRuns PilotSimulationRun[]

  @@index([scenarioId])
  @@index([ownerUserId])
  @@index([domain])
  @@index([status])
  @@index([origin])
  @@map("challenges")
}

enum MatchStatus {
  SUGGESTED
  SHORTLISTED
  REJECTED
  SELECTED
}

/// An AI-assisted recommendation for one challenge and one startup.
///
/// The per-axis scores are stored as columns rather than folded into
/// `overallScore` alone, because a recommendation an officer cannot take apart
/// is one they cannot defend in an audit. `breakdown` holds the working — which
/// evidence moved which axis — and `rationale` states it in a sentence.
///
/// Nothing here is a decision. A `SELECTED` match records that a human selected
/// it; it does not record the model selecting anything.
model StartupMatch {
  id          String    @id @default(uuid())
  challenge   Challenge @relation(fields: [challengeId], references: [id], onDelete: Cascade)
  challengeId String
  startup     Startup   @relation(fields: [startupId], references: [id], onDelete: Cascade)
  startupId   String

  /// All scores 0–1. Kept as separate axes so a weak overall score can be read
  /// as "no government delivery history" rather than as a verdict.
  problemFitScore           Float
  technicalFitScore         Float
  deploymentReadinessScore  Float
  governmentExperienceScore Float
  evidenceStrengthScore     Float
  pilotReadinessScore       Float
  financialEvidenceScore    Float?
  scalabilityScore          Float?
  overallScore              Float

  /// Per-axis working: the evidence each score was derived from.
  breakdown Json
  rationale String
  status    MatchStatus @default(SUGGESTED)

  /// Which provider connection produced this, when one did. Null for a match
  /// assembled without a model.
  generatedBy             AIProviderConnection? @relation(fields: [generatedByConnectionId], references: [id], onDelete: SetNull)
  generatedByConnectionId String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  evaluations Evaluation[]

  @@unique([challengeId, startupId])
  @@index([challengeId])
  @@index([startupId])
  @@index([status])
  @@map("startup_matches")
}

enum EvaluationStatus {
  DRAFT
  SUBMITTED
  FINAL
}

enum EvaluationRecommendation {
  PILOT
  REJECT
  NEEDS_MORE_EVIDENCE
  HOLD
}

/// A human expert's review of a match.
///
/// This model is the reason the trust chain holds. A match is a suggestion; an
/// evaluation is a named person's judgement of it, and only an evaluation can
/// carry a pilot recommendation. `NEEDS_MORE_EVIDENCE` is a first-class
/// recommendation rather than a comment field because "we cannot yet tell" is a
/// legitimate and common outcome, and forcing it into PILOT or REJECT is how
/// weak evidence gets laundered into a decision.
model Evaluation {
  id      String       @id @default(uuid())
  match   StartupMatch @relation(fields: [matchId], references: [id], onDelete: Cascade)
  matchId String

  evaluator       UserProfile @relation(fields: [evaluatorUserId], references: [id], onDelete: Restrict)
  evaluatorUserId String

  /// Named criteria with their weights and scores, as applied.
  criteria       Json
  compositeScore Float
  recommendation EvaluationRecommendation
  status         EvaluationStatus         @default(DRAFT)
  comments       String?
  decidedAt      DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([matchId])
  @@index([evaluatorUserId])
  @@index([status])
  @@map("evaluations")
}

// ------------------------------------------------------------------
// Pilot
// ------------------------------------------------------------------

enum PilotStatus {
  PLANNED
  ACTIVE
  AWAITING_VALIDATION
  CLOSED
  CANCELLED
}

enum PilotOutcome {
  TARGET_MET
  PARTIALLY_MET
  TARGET_MISSED
}

/// How trustworthy the baseline measurement was before the pilot began.
enum BaselineQuality {
  NONE
  PARTIAL
  GOOD
}

/// Controlled vocabulary for what went wrong.
///
/// Free text would make the risk register unaggregatable — "we could not dig"
/// and "no excavation crew" are the same finding and must count once. A closed
/// pilot's causes become preconditions on the next comparable challenge, which
/// is the mechanism that makes a failed pilot institutionally useful rather
/// than a write-off.
enum FailureCause {
  INSUFFICIENT_BASELINE
  DELIVERY_CAPACITY
  COVERAGE_SHORTFALL
  DATA_QUALITY
  SEASONAL_WINDOW
  INTEGRATION_GAP
  SCOPE_TOO_WIDE
  TAXONOMY_MISMATCH
}

/// One controlled experiment. The canonical pilot entity.
///
/// There is exactly one pilot model. The earlier design split a running pilot
/// from a closed "corpus record", which meant closing a pilot required copying
/// it and left two rows that could disagree. Here a closed pilot simply has
/// `status = CLOSED`, and the historical corpus is a query rather than a table:
/// closing a pilot makes it evidence for the next department with no copy step.
///
/// The hazard that follows from that, and the reason `origin` is indexed: a
/// DEMO pilot is structurally identical to a real one, so any aggregate that
/// forgets to filter turns a constructed scenario into a statistic. Analytical
/// queries must name the origins they include.
model Pilot {
  id          String    @id @default(uuid())
  challenge   Challenge @relation(fields: [challengeId], references: [id], onDelete: Restrict)
  challengeId String
  startup     Startup   @relation(fields: [startupId], references: [id], onDelete: Restrict)
  startupId   String

  department String
  location   String?

  contractValue   Decimal         @db.Decimal(14, 2)
  durationDays    Int
  /// Days of baseline capture before any outcome claim is contractable.
  baselineDays    Int
  baselineQuality BaselineQuality
  scopeUnits      Int
  /// Unit the scope is counted in — wards, depots, corridors. Domain-specific.
  scopeUnitLabel  String

  status        PilotStatus    @default(PLANNED)
  outcome       PilotOutcome?
  failureCauses FailureCause[]

  origin       DataOrigin
  demoScenario String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  scenario   SimulationScenario? @relation(fields: [scenarioId], references: [id], onDelete: Cascade)
  scenarioId String?

  milestones    PilotMilestone[]
  metrics       PilotMetric[]
  evidence      PilotEvidence[]
  scaleDecision ScaleDecision?

  @@index([scenarioId])
  @@index([challengeId])
  @@index([startupId])
  @@index([status])
  @@index([origin])
  @@map("pilots")
}

enum MilestoneStatus {
  LOCKED
  IN_PROGRESS
  EVIDENCE_SUBMITTED
  APPROVED
  PAID
  REJECTED
}

/// One milestone in a pilot contract.
///
/// The rule this model exists to enforce is one sentence:
///
///     evidence → approval → payment
///
/// It is a state machine rather than a convention, because a convention is what
/// gets skipped under deadline pressure. No transition releases payment without
/// a prior approval, and no approval is reachable without filed evidence.
///
/// `code` carries the domain-facing identifier (`M1`), which is unique only
/// within its pilot — two pilots both have an M1 — so the primary key is a
/// surrogate and uniqueness is scoped to the pilot.
model PilotMilestone {
  id      String @id @default(uuid())
  code    String
  pilot   Pilot  @relation(fields: [pilotId], references: [id], onDelete: Cascade)
  pilotId String

  title       String
  description String
  /// Rupees released on approval. Decimal, not Float: this is reconciled
  /// against a contract, and binary floating point cannot represent it exactly.
  payment     Decimal @db.Decimal(14, 2)

  /// Evidence that must be filed before approval is possible. Data rather than
  /// schema, because the required list varies per contract.
  evidenceRequired String[]

  status MilestoneStatus @default(LOCKED)
  dueOn  DateTime        @db.Date

  approvedBy      String?
  approvedAt      DateTime?
  paidAt          DateTime?
  /// Kept when a submission is rejected, so the trail survives the milestone
  /// returning to an earlier state.
  rejectionReason String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  evidence PilotEvidence[]

  @@unique([pilotId, code])
  @@index([status])
  @@map("pilot_milestones")
}

/// One measured quantity on a pilot.
///
/// `method` is required, not optional. A number without a stated measurement
/// method is not a KPI — it is an assertion, and the independent validation the
/// problem statement asks for has nothing to check it against.
///
/// `achievedValue` stays null until the measurement actually exists. There is
/// no default of zero, because a zero here would read as "no improvement" when
/// it means "not yet measured".
model PilotMetric {
  id      String @id @default(uuid())
  pilot   Pilot  @relation(fields: [pilotId], references: [id], onDelete: Cascade)
  pilotId String

  name          String
  unit          String
  baselineValue Float?
  targetValue   Float
  achievedValue Float?
  measuredAt    DateTime?
  /// How the figure is obtained, in one line.
  method        String

  /// The pilot's headline KPI — the one the outcome is judged on.
  ///
  /// Exactly one per pilot, enforced by a partial unique index added by hand in
  /// the migration (Prisma cannot express a filtered unique). Without it a
  /// pilot could carry two "primary" metrics and the reported outcome would
  /// depend on row order.
  isPrimary Boolean @default(false)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  evidence PilotEvidence[]

  @@index([pilotId])
  @@map("pilot_metrics")
}

/// A filed artefact backing a claim.
///
/// Attachable to a milestone (backing a payment claim), to a metric (backing a
/// KPI claim), or to the pilot alone. `pilotId` is always required, so evidence
/// can never float free of the pilot it belongs to.
///
/// `reference` points at the artefact in whatever system of record holds it.
/// Binary storage is deliberately out of scope for this round.
model PilotEvidence {
  id      String @id @default(uuid())
  pilot   Pilot  @relation(fields: [pilotId], references: [id], onDelete: Cascade)
  pilotId String

  milestone   PilotMilestone? @relation(fields: [milestoneId], references: [id], onDelete: Cascade)
  milestoneId String?
  metric      PilotMetric?    @relation(fields: [metricId], references: [id], onDelete: Cascade)
  metricId    String?
  document    Document?       @relation(fields: [documentId], references: [id], onDelete: SetNull)
  documentId  String?

  label     String
  reference String

  submittedBy       UserProfile @relation("EvidenceSubmitter", fields: [submittedByUserId], references: [id], onDelete: Restrict)
  submittedByUserId String
  submittedAt       DateTime

  /// Evidence is filed, then judged. A submission is not an accepted fact, and
  /// collapsing the two would let a startup's own upload count as validation.
  status EvidenceStatus @default(SUBMITTED)

  reviewedBy       UserProfile? @relation("EvidenceReviewer", fields: [reviewedByUserId], references: [id], onDelete: SetNull)
  reviewedByUserId String?
  reviewedAt       DateTime?
  /// Why it was accepted or rejected. Required in practice on a rejection.
  reviewNote       String?

  createdAt DateTime @default(now())

  @@index([pilotId])
  @@index([milestoneId])
  @@index([metricId])
  @@index([documentId])
  @@index([status])
  @@map("pilot_evidence")
}

enum EvidenceStatus {
  SUBMITTED
  ACCEPTED
  REJECTED
}

enum ScaleDecisionType {
  SCALE
  EXTEND_PILOT
  STOP
}

/// The government's decision on a completed pilot. One per pilot.
///
/// `rationale` and `decidedByUserId` are both required: a procurement decision
/// that cannot name who made it and on what basis is not defensible, and this
/// is the one table in the schema where an unattributed row would be worst.
/// Nothing in the model permits a decision to be recorded by anything other
/// than a user.
model ScaleDecision {
  id      String @id @default(uuid())
  pilot   Pilot  @relation(fields: [pilotId], references: [id], onDelete: Cascade)
  pilotId String @unique

  decision  ScaleDecisionType
  rationale String

  decidedBy       UserProfile @relation(fields: [decidedByUserId], references: [id], onDelete: Restrict)
  decidedByUserId String
  decidedAt       DateTime

  createdAt DateTime @default(now())

  @@index([decidedByUserId])
  @@map("scale_decisions")
}

// ------------------------------------------------------------------
// Documents and retrieval
// ------------------------------------------------------------------

enum DocumentKind {
  POLICY
  ELIGIBILITY
  AGREEMENT
  CYBERSECURITY
  IP_DATA
  PILOT_REPORT
  EVALUATION
  PROCUREMENT
  OTHER
}

/// A source document the platform can quote.
///
/// This replaces the earlier hand-written clause table, which held invented
/// passages. Nothing is stored here that was not ingested from a real document,
/// and a VERIFIED document must cite its EvidenceSource.
model Document {
  id          String       @id @default(uuid())
  kind        DocumentKind
  title       String
  publisher   String
  url         String?
  retrievedAt DateTime     @db.Date

  origin   DataOrigin
  source   EvidenceSource? @relation(fields: [sourceId], references: [id], onDelete: Restrict)
  sourceId String?

  fileHash      String?
  originalPath  String?
  extractedText String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  chunks           DocumentChunk[]
  startupDocuments StartupDocument[]
  pilotEvidences   PilotEvidence[]

  @@index([kind])
  @@index([origin])
  @@map("documents")
}

/// Association between a Startup and a Document dossier entry.
model StartupDocument {
  id         String   @id @default(uuid())
  startup    Startup  @relation(fields: [startupId], references: [id], onDelete: Cascade)
  startupId  String
  document   Document @relation(fields: [documentId], references: [id], onDelete: Cascade)
  documentId String
  category   String
  label      String?
  createdAt  DateTime @default(now())

  @@unique([startupId, documentId])
  @@index([startupId])
  @@index([documentId])
  @@index([category])
  @@map("startup_documents")
}

/// One retrievable passage.
///
/// `content` is stored verbatim and is what gets quoted back to a reader. The
/// separation that matters: a retrieval answer quotes chunks and labels any
/// synthesis as generated. A response that returned only prose would be
/// indefensible in a procurement review.
///
/// `pageNumber` and `sectionRef` exist so a quoted passage can be located in
/// the original document by a human who wants to check it.
///
/// `embedding` is `vector(768)`, matching `nomic-embed-text`. Prisma cannot
/// express the pgvector type, so it is declared Unsupported and read through
/// raw SQL; the extension and the HNSW cosine index are created by hand in the
/// migration. `embeddingModel` records which model produced the vector, so a
/// corpus embedded by two different models is detectable rather than silently
/// incomparable.
model DocumentChunk {
  id         String   @id @default(uuid())
  document   Document @relation(fields: [documentId], references: [id], onDelete: Cascade)
  documentId String

  ordinal    Int
  content    String
  pageNumber Int?
  sectionRef String?
  tokenCount Int?

  embeddingModel String
  embedding      Unsupported("vector(768)")?

  createdAt DateTime @default(now())

  @@unique([documentId, ordinal])
  @@index([documentId])
  @@map("document_chunks")
}

// ------------------------------------------------------------------
// Audit
// ------------------------------------------------------------------

enum AuditAction {
  CHALLENGE_STATUS_CHANGED
  MATCH_STATUS_CHANGED
  EVALUATION_SUBMITTED
  EVALUATION_DECIDED
  PILOT_STATUS_CHANGED
  EVIDENCE_SUBMITTED
  MILESTONE_APPROVED
  MILESTONE_REJECTED
  PAYMENT_RELEASED
  VALIDATION_RECORDED
  SCALE_DECISION_RECORDED
}

/// One immutable line in the lifecycle trail.
///
/// Append-only by contract: the application writes a row for every significant
/// transition and exposes no update or delete path to this table.
///
/// There are deliberately no foreign keys. `subjectType`/`subjectId` and
/// `actorUserId` are plain columns so the trail survives the deletion of what
/// it describes — an audit log a cascade can erase is not an audit log, and
/// that is precisely the case where it is most needed.
model AuditEvent {
  id          String      @id @default(uuid())
  at          DateTime    @default(now())
  actorUserId String?
  /// The entity kind, e.g. `Pilot`, `Evaluation`.
  subjectType String
  subjectId   String
  action      AuditAction
  detail      String

  @@index([subjectType, subjectId, at])
  @@index([at])
  @@map("audit_events")
}

/// Tracked user session record for security auditing and activity history.
model UserSession {
  id          String    @id @default(uuid())
  userId      String
  userEmail   String
  role        UserRole
  loginAt     DateTime  @default(now())
  logoutAt    DateTime?
  lastActive  DateTime  @default(now())
  ipAddress   String?
  userAgent   String?
  activityLog Json?

  @@index([userId])
  @@index([loginAt])
  @@map("user_sessions")
}

/* ------------------------------------------------------------------ */
/* Pilot simulation                                                     */
/* ------------------------------------------------------------------ */

/// Where a simulation run has reached.
///
/// A run takes minutes, so it has to survive a page refresh and a server
/// restart with its state legible. RUNNING with a stale `updatedAt` is how a
/// crashed run is told apart from a slow one.
enum SimulationRunStatus {
  QUEUED
  RUNNING
  COMPLETE
  FAILED
  CANCELLED
}

/// One execution of the pilot simulation model over a cohort.
///
/// The row carries its own `modelVersion` and the full `assumptions` it ran
/// under. That is not bookkeeping — a ranking is meaningless without the
/// parameters that produced it, and a result read six months later against a
/// changed model would be quietly wrong. Storing them together means a run is
/// always interpretable against the model that made it.
///
/// Progress counters are written during the run so the interface can show real
/// state rather than an animated guess.
model PilotSimulationRun {
  id          String    @id @default(uuid())
  challenge   Challenge @relation(fields: [challengeId], references: [id], onDelete: Cascade)
  challengeId String

  createdBy       UserProfile @relation(fields: [createdByUserId], references: [id], onDelete: Restrict)
  createdByUserId String

  status SimulationRunStatus @default(QUEUED)

  /// Everything random in the run derives from this. Same seed, same result.
  seed               Int
  runsPerCompany     Int
  perturbationPasses Int
  modelVersion       String
  /// The parameter set, printed, so the ranking can be read against it.
  assumptions        Json

  /// Live progress, polled by the running view.
  phase         String @default("QUEUED")
  cohortSize    Int    @default(0)
  eligibleCount Int    @default(0)
  companiesDone Int    @default(0)
  passesDone    Int    @default(0)
  runsDone      Int    @default(0)
  simulatedDays BigInt @default(0)

  startedAt  DateTime?
  finishedAt DateTime?
  /// Why it failed, when it did. Shown rather than swallowed.
  error      String?

  /// Always DEMO. A simulation is never a record of something that happened.
  origin DataOrigin @default(DEMO)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  results PilotSimulationResult[]

  @@index([challengeId])
  @@index([status])
  @@index([createdByUserId])
  @@map("pilot_simulation_runs")
}

/// One company's result within a run.
///
/// Counts are stored with their denominator (`runsTotal`) rather than as a
/// rate. "142 of 200 runs" is a statement about the model and can be checked;
/// "71%" invites being read as a probability that this company will succeed,
/// which nothing here supports.
model PilotSimulationResult {
  id    String             @id @default(uuid())
  run   PilotSimulationRun @relation(fields: [runId], references: [id], onDelete: Cascade)
  runId String

  startup   Startup @relation(fields: [startupId], references: [id], onDelete: Cascade)
  startupId String

  /// A screened-out company keeps its row and its reason. Who was excluded, and
  /// why, is part of the answer rather than noise to be dropped.
  eligible        Boolean
  exclusionReason String?

  runsMetTarget Int @default(0)
  runsPartial   Int @default(0)
  runsMissed    Int @default(0)
  runsTotal     Int @default(0)

  medianAchieved         Float?
  p10                    Float?
  p90                    Float?
  medianCoverage         Float?
  medianMobilisationDays Float?

  /// What bound the runs that missed, and the contract condition it implies.
  dominantCause FailureCause?
  precondition  String?

  rankPosition Int?
  /// In how many of the perturbation passes this company held its position.
  rankStability Float?

  /// The median daily curve. Stored for the leading companies only — 515 rows
  /// each carrying 90 points would dominate the table for data nobody opens.
  trajectory Json?

  createdAt DateTime @default(now())

  @@unique([runId, startupId])
  @@index([runId, rankPosition])
  @@index([startupId])
  @@map("pilot_simulation_results")
}
