# Backend API base URL
NEXT_PUBLIC_API_BASE_URL=http://localhost:5000

# Supabase Auth — browser client.
# Both values are public by design and appear in the client bundle.
# NEXT_PUBLIC_SUPABASE_URL is https://<project-ref>.supabase.co
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Never add here:
#   SUPABASE_SECRET_KEY, DATABASE_URL, ANTHROPIC_API_KEY,
#   AI_CREDENTIAL_ENCRYPTION_KEY
# Anything NEXT_PUBLIC_ is shipped to every visitor's browser.
