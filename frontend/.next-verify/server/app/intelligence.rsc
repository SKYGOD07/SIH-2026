0:["wacIiRZVxY9TnO88SuIP9",[[["",{"children":["intelligence",{"children":["__PAGE__",{}]}]},"$undefined","$undefined",true],["",{"children":["intelligence",{"children":["__PAGE__",{},[["$L1",[["$","$L2",null,{"index":"—","eyebrow":"Institutional intelligence","title":"What the state has learned","lede":"Every completed pilot leaves a node behind: the problem it addressed, the evidence it produced, and the constraint it exposed. A department starting a comparable challenge starts from this record rather than from scratch."}],["$","$L3",null,{}],["$","$L4",null,{}],["$","section",null,{"aria-label":"Policy corpus","className":"relative w-full ground-ink py-[clamp(5rem,12vh,9rem)]","children":["$","div",null,{"className":"edge mx-auto max-w-[110rem]","children":[["$","$L5",null,{"index":"—","children":"Policy corpus"}],["$","h2",null,{"className":"mt-6 max-w-[22ch] font-display text-display-sm font-medium uppercase leading-[0.9] text-ivory","children":"Every conclusion cites a clause."}],["$","p",null,{"className":"mt-6 max-w-[62ch] text-pretty text-base leading-relaxed text-silver","children":"Eligibility, security and contracting questions are answered by retrieving from this corpus and quoting it. The analysis that accompanies a retrieval is assistive; the determination stays with the department’s competent authority."}],["$","ul",null,{"className":"mt-14 grid gap-px border-t border-ivory/10 md:grid-cols-2","children":[["$","li","SRC-P-014",{"className":"border-b border-ivory/10 py-7 md:pr-10","children":[["$","div",null,{"className":"flex flex-wrap items-baseline justify-between gap-3","children":[["$","span",null,{"className":"font-mono text-meta uppercase text-saffron","children":"Procurement policy"}],["$","span",null,{"className":"font-mono text-[0.625rem] uppercase tracking-[0.12em] text-silver","children":"SRC-P-014"}]]}],["$","h3",null,{"className":"mt-3 font-display text-xl uppercase leading-tight text-ivory","children":"Innovation Procurement Policy"}],["$","p",null,{"className":"mt-1.5 font-mono text-meta uppercase text-silver","children":"Clause 4.2 — Relaxation of prior turnover and experience"}],["$","blockquote",null,{"className":"mt-4 border-l border-ivory/20 pl-4","children":["$","p",null,{"className":"max-w-[56ch] text-sm italic leading-relaxed text-ivory/75","children":["“","For challenges routed through the innovation pathway, prior turnover and prior supply experience conditions shall not be applied as qualifying criteria at the pilot stage.","”"]}]}]]}],["$","li","SRC-E-007",{"className":"border-b border-ivory/10 py-7 md:pr-10","children":[["$","div",null,{"className":"flex flex-wrap items-baseline justify-between gap-3","children":[["$","span",null,{"className":"font-mono text-meta uppercase text-saffron","children":"Eligibility rule"}],["$","span",null,{"className":"font-mono text-[0.625rem] uppercase tracking-[0.12em] text-silver","children":"SRC-E-007"}]]}],["$","h3",null,{"className":"mt-3 font-display text-xl uppercase leading-tight text-ivory","children":"Startup Eligibility Rules"}],["$","p",null,{"className":"mt-1.5 font-mono text-meta uppercase text-silver","children":"Rule 3(b) — Recognition and standing"}],["$","blockquote",null,{"className":"mt-4 border-l border-ivory/20 pl-4","children":["$","p",null,{"className":"max-w-[56ch] text-sm italic leading-relaxed text-ivory/75","children":["“","An entity holding valid DPIIT recognition and no adverse compliance finding in the preceding 24 months is eligible to participate in a controlled pilot.","”"]}]}]]}],["$","li","SRC-A-021",{"className":"border-b border-ivory/10 py-7 md:pr-10","children":[["$","div",null,{"className":"flex flex-wrap items-baseline justify-between gap-3","children":[["$","span",null,{"className":"font-mono text-meta uppercase text-saffron","children":"Pilot agreement"}],["$","span",null,{"className":"font-mono text-[0.625rem] uppercase tracking-[0.12em] text-silver","children":"SRC-A-021"}]]}],["$","h3",null,{"className":"mt-3 font-display text-xl uppercase leading-tight text-ivory","children":"Standard Pilot Agreement"}],["$","p",null,{"className":"mt-1.5 font-mono text-meta uppercase text-silver","children":"Schedule II — Scope limitation"}],["$","blockquote",null,{"className":"mt-4 border-l border-ivory/20 pl-4","children":["$","p",null,{"className":"max-w-[56ch] text-sm italic leading-relaxed text-ivory/75","children":["“","A controlled pilot is limited to the wards, depots or facilities named in Schedule I, and confers no right to supply beyond that scope.","”"]}]}]]}],["$","li","SRC-C-009",{"className":"border-b border-ivory/10 py-7 md:pr-10","children":[["$","div",null,{"className":"flex flex-wrap items-baseline justify-between gap-3","children":[["$","span",null,{"className":"font-mono text-meta uppercase text-saffron","children":"Cybersecurity requirement"}],["$","span",null,{"className":"font-mono text-[0.625rem] uppercase tracking-[0.12em] text-silver","children":"SRC-C-009"}]]}],["$","h3",null,{"className":"mt-3 font-display text-xl uppercase leading-tight text-ivory","children":"Departmental Cybersecurity Baseline"}],["$","p",null,{"className":"mt-1.5 font-mono text-meta uppercase text-silver","children":"Section 6 — Data residency and access"}],["$","blockquote",null,{"className":"mt-4 border-l border-ivory/20 pl-4","children":["$","p",null,{"className":"max-w-[56ch] text-sm italic leading-relaxed text-ivory/75","children":["“","Operational data generated during a pilot shall be stored within state-controlled infrastructure, with role-based access logged and auditable.","”"]}]}]]}],["$","li","SRC-I-011",{"className":"border-b border-ivory/10 py-7 md:pr-10","children":[["$","div",null,{"className":"flex flex-wrap items-baseline justify-between gap-3","children":[["$","span",null,{"className":"font-mono text-meta uppercase text-saffron","children":"IP & data clause"}],["$","span",null,{"className":"font-mono text-[0.625rem] uppercase tracking-[0.12em] text-silver","children":"SRC-I-011"}]]}],["$","h3",null,{"className":"mt-3 font-display text-xl uppercase leading-tight text-ivory","children":"IP and Data Clauses"}],["$","p",null,{"className":"mt-1.5 font-mono text-meta uppercase text-silver","children":"Clause 9 — Background and foreground IP"}],["$","blockquote",null,{"className":"mt-4 border-l border-ivory/20 pl-4","children":["$","p",null,{"className":"max-w-[56ch] text-sm italic leading-relaxed text-ivory/75","children":["“","Background IP remains with the originating party. Foreground IP created specifically under the pilot is jointly recorded, with a licence to the department for continued operational use.","”"]}]}]]}],["$","li","SRC-R-104",{"className":"border-b border-ivory/10 py-7 md:pr-10","children":[["$","div",null,{"className":"flex flex-wrap items-baseline justify-between gap-3","children":[["$","span",null,{"className":"font-mono text-meta uppercase text-saffron","children":"Previous pilot report"}],["$","span",null,{"className":"font-mono text-[0.625rem] uppercase tracking-[0.12em] text-silver","children":"SRC-R-104"}]]}],["$","h3",null,{"className":"mt-3 font-display text-xl uppercase leading-tight text-ivory","children":"Nashik Water Pilot — Validation Report"}],["$","p",null,{"className":"mt-1.5 font-mono text-meta uppercase text-silver","children":"Pilot PL-2907, closed 2025"}],["$","blockquote",null,{"className":"mt-4 border-l border-ivory/20 pl-4","children":["$","p",null,{"className":"max-w-[56ch] text-sm italic leading-relaxed text-ivory/75","children":["“","Non-revenue water reduced by 26% across two wards over 120 days. Detection latency fell from 9 days to 41 hours. Result independently verified by the municipal engineering wing.","”"]}]}]]}],["$","li","SRC-V-002",{"className":"border-b border-ivory/10 py-7 md:pr-10","children":[["$","div",null,{"className":"flex flex-wrap items-baseline justify-between gap-3","children":[["$","span",null,{"className":"font-mono text-meta uppercase text-saffron","children":"Evaluation framework"}],["$","span",null,{"className":"font-mono text-[0.625rem] uppercase tracking-[0.12em] text-silver","children":"SRC-V-002"}]]}],["$","h3",null,{"className":"mt-3 font-display text-xl uppercase leading-tight text-ivory","children":"Evaluation Framework"}],["$","p",null,{"className":"mt-1.5 font-mono text-meta uppercase text-silver","children":"Annexure A — Weighted criteria"}],["$","blockquote",null,{"className":"mt-4 border-l border-ivory/20 pl-4","children":["$","p",null,{"className":"max-w-[56ch] text-sm italic leading-relaxed text-ivory/75","children":["“","Proposals are scored on technical capability, impact, feasibility, security, scalability and cost. Assisted analysis may inform the panel; the panel records the decision.","”"]}]}]]}]]}]]}]}]],null],null],null]},[null,["$","$L6",null,{"parallelRouterKey":"children","segmentPath":["children","intelligence","children"],"error":"$undefined","errorStyles":"$undefined","errorScripts":"$undefined","template":["$","$L7",null,{}],"templateStyles":"$undefined","templateScripts":"$undefined","notFound":"$undefined","notFoundStyles":"$undefined"}]],null]},[[[["$","link","0",{"rel":"stylesheet","href":"/_next/static/css/100a3c19a5f497f0.css","precedence":"next","crossOrigin":"$undefined"}]],["$","html",null,{"lang":"en","className":"__variable_50bf36 __variable_f367f3 __variable_6d24ac","suppressHydrationWarning":true,"children":["$","body",null,{"className":"min-h-screen bg-ink-950 font-sans text-ivory antialiased","children":[["$","a",null,{"href":"#main","className":"sr-only focus:not-sr-only focus:fixed focus:left-4 focus:top-4 focus:z-[200] focus:bg-saffron focus:px-4 focus:py-2 focus:font-mono focus:text-meta focus:uppercase focus:text-ink","children":"Skip to content"}],["$","$L8",null,{"children":["$","$L9",null,{"children":["$","$La",null,{"children":[["$","$Lb",null,{}],["$","$Lc",null,{}],["$","$Ld",null,{}],["$","div",null,{"className":"relative z-10","children":[["$","main",null,{"id":"mai